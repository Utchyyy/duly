# Public values (safe in the browser). Optional: the app falls back to these if unset.
VITE_SUPABASE_URL=https://mnlyltdxnvzbttugkmng.supabase.co
VITE_SUPABASE_PUBLISHABLE=sb_publishable_dAgs_1vEd3046QRq7TZrUg_-JTERFrF

# AI brief drafting (optional). SERVER ONLY: set these in Vercel / your server environment, never with a VITE_
# prefix and never in the browser. Without the key, "Draft from a document" tells people it is not switched on yet
# and everything else works as normal.
# ANTHROPIC_API_KEY=
# DRAFT_MODEL=claude-opus-5-5

# Notification emails (optional). SERVER ONLY: set these in Vercel / your server environment, never with a VITE_
# prefix. In-app notifications work without any of them. Without the provider settings, emails stay queued (and are
# dropped after 48 hours), so it is safe to switch this on later.
# SUPABASE_SERVICE_ROLE_KEY=      claims and reports queued emails; the only thing that may call the worker functions
# CRON_SECRET=                    long random string; the scheduler sends it as "Authorization: Bearer ..."
# RESEND_API_KEY=
# EMAIL_FROM="Duly <notifications@your-domain>"
# APP_URL=https://your-app-address   used for the links inside emails
